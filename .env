# Database Configuration
DB_PATH=./megamind_db
COLLECTION_NAME=megamind

# Ollama Server
# (Change this if you ever move Ollama to a different machine, like a Raspberry Pi)
OLLAMA_HOST=http://localhost:11434 # Please don't add a '/' after the port number

# AI Models
EMBED_MODEL=qwen3-embedding:4b
CHAT_MODEL=llama3.1:8b
CONTEXT_LIMIT=16384
ROUTER_MODEL=llama3.1:8b # Model used for query routing, small thinking model preferred
ROUTER_CONTEXT=4096
OCR_MODEL=glm-ocr:latest
VECTOR_SIZE=2560

## ADVANCED SETTINGS ##
TOP_K_CHUNKS=14 # Specifies the number of chunks returned from the database 
DENSE_THRESHOLD=0.5 # Defines the cosine similarity match for the dense threshold, higer means more accurate chunks are returned
