# Database Configuration
DB_PATH=./megamind_db
COLLECTION_NAME=megamind

# Ollama Server
# (Change this if you ever move Ollama to a different machine, like a Raspberry Pi)
OLLAMA_HOST=http://localhost:11434 # Please don't add a '/' after the port number

# AI Models
EMBED_MODEL=embeddinggemma:300m
CHAT_MODEL=deepseek-r1:8b
ROUTER_MODEL=lfm2.5:8b # Model used for query routing, small thinking model preferred
CONTEXT_LIMIT=8192
OCR_MODEL=glm-ocr
VECTOR_SIZE=768